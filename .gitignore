node_modules/
.env
playwright-report/
test-results/

# Windows system files
desktop.ini

# Reference PDFs
*.pdf

# Throwaway ad-hoc Playwright specs (run-coachapp / mobile-check) — never commit
tests/_adhoc.spec.js
tests/zz-*.spec.js
tests/_debug-*.spec.js
adhoc.png
mobile.png

# Local editor config (machine-specific, never shared)
.vscode/

# Ad-hoc debug/visual screenshots left behind by run-coachapp / mobile-check sessions.
# Same class as adhoc.png / mobile.png above — these just never got added, and two pre-push
# reviews flagged them as commit-risk because `git add -A` would sweep them into a real commit.
# The FILES are deliberately left on disk; only the commit risk is removed.
*-debug*.png
visual-*.png
mobile-input.png

# Captured Supabase sessions for the E2E suite (tests/session-store.js). Real access tokens
# for the test accounts, regenerated by globalSetup on every run — never commit them.
tests/.sessions/

# Release gate receipt (scripts/release.mjs). Records that the full suite passed on one exact commit,
# so cutting a release minutes after a green run does not re-run 30 minutes of tests. Keyed to the
# sha, so it can never vouch for code that changed since. Local state, never committed.
.release-receipt.json
